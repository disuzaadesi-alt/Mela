generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Product {
  id          String      @id @default(uuid())
  name        String
  category    String
  price       Int
  mrp         Int
  stock       Int         @default(0)
  rating      Float       @default(4.2)
  reviews     Int         @default(0)
  imageSeed   String
  description String
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

enum OrderStage {
  PLACED
  CONFIRMED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  COD
}

model Order {
  id                String        @id @default(uuid())
  user              User          @relation(fields: [userId], references: [id])
  userId            String
  items             OrderItem[]
  total             Int
  shipping          Int           @default(0)
  paymentMethod     String
  paymentStatus     PaymentStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  stage             OrderStage    @default(PLACED)
  addressName       String
  addressPhone      String
  addressLine1      String
  addressCity       String
  addressPincode    String
  createdAt         DateTime      @default(now())
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  name      String
  price     Int
  qty       Int
}
